# Copy to .env.local for local overrides. Never commit real credentials.

# Canonical public URL of the storefront (https://…/). When set, the build adds
# <link rel="canonical">, og:url and sitemap.xml. Leave empty until the canonical host is chosen.
SITE_URL=""

# Point the app at the local Firebase Emulator Suite (demo project; never touches real data).
# Used by `npm run test:e2e:emulator`.
VITE_FIREBASE_EMULATORS="false"

# scripts/set-staff-claims.mjs uses Application Default Credentials:
#   gcloud auth application-default login
# or set GOOGLE_APPLICATION_CREDENTIALS to a service-account key stored OUTSIDE this repository.

{
  "name": "yummy-sweets",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist test-results playwright-report",
    "lint": "tsc --noEmit -p tsconfig.json && node scripts/check-secrets.mjs --source-only",
    "test": "npm run test:unit && npm run test:rules && npm run test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --config firebase.test.json --only firestore,auth --project demo-yummy-sweets \"vitest run tests/rules\"",
    "test:e2e": "E2E_PROJECT=storefront playwright test",
    "test:e2e:emulator": "firebase emulators:exec --config firebase.test.json --only firestore,auth --project demo-yummy-sweets \"E2E_PROJECT=emulator playwright test\"",
    "check:secrets": "node scripts/check-secrets.mjs",
    "staff:claims": "node scripts/set-staff-claims.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.14.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1",
    "typescript": "~5.8.2",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
